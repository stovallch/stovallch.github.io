---
import { Image } from 'astro:assets';
import Logo from '../assets/images/icons/StovallCH.svg'

interface MenuItem {
  label: string;
  href: string;
  class: string;
}

interface Props {
  preItems?: MenuItem[];
  postItems?: MenuItem[];
}

const {
  preItems = [
    { label: 'Who', class: 'menu-item', href: '#who' },
    { label: 'What', class: 'menu-item ', href: '#what' },
  ],
  postItems = [
    { label: 'How', class: 'menu-item ', href: '#how' },
	{ label: 'Why', class: 'menu-item ', href: '#why' },
  ],
} = Astro.props;
---

<div class="component navbar" id="nb" data-menu>
	<!-- LEFT NAVBAR ITEMS -->
	{
		preItems.map((item) => {
			return (
				<a 
				href={item.href} 
				class:list={item.class}
				>
						{item.label}
				</a>
			);
		})
	}
	<!-- CENTER NAVBAR LOGO -->
	<a href="/" class="menu-item" >
		<Image 
			src={Logo}
			loading="eager"
			alt="Stovall C&H Logo"
			class="logo"
		/>
	</a>
	<!-- RIGHT NAVBAR ITEMS -->
	{
		postItems.map((item) => {
			return (
				<a 
				href={item.href} 
				class:list={item.class}
				>
						{item.label}
				</a>
			);
		})
	}
</div>
